settings:
  default_route: "primary-route"
  temperature: 0.7
  max_tool_iterations: 10

models:
  - model_name: "primary-route"
    litellm_model: "groq/your-primary-model-here"
    api_key_env: "GROQ_API_KEY"

  - model_name: "fallback-route-1"
    litellm_model: "openrouter/your-fallback-model-here"
    api_key_env: "OPENROUTER_API_KEY"

fallbacks:
  - primary: "primary-route"
    chain:
      - "fallback-route-1"
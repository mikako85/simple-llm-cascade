settings:
  default_route: 'groq-primary'
  temperature: 0.7
  max_tool_iterations: 10

models:
  - model_name: 'groq-primary'
    litellm_model: 'groq/openai/gpt-oss-120b'
    api_key_env: 'GROQ_API_KEY'

  - model_name: 'openrouter-fallback'
    litellm_model: 'openrouter/nvidia/nemotron-3-super-120b-a12b:free'
    api_key_env: 'OPENROUTER_API_KEY'

  - model_name: 'deepseek-fallback'
    litellm_model: 'deepseek/deepseek-flash'
    api_key_env: 'DEEPSEEK_API_KEY'

fallbacks:
  - primary: 'groq-primary'
    chain:
      - 'openrouter-fallback'
      - 'deepseek-fallback'